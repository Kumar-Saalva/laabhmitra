  {
   "id": "pmegp",
   "short_name": "PMEGP",
   "name": "Prime Minister's Employment Generation Programme (PMEGP)",
   "level": "central",
   "state": null,
   "ministry": "Ministry of MSME (implemented by KVIC, KVIBs, DICs)",
   "kind": "subsidy",
   "status": "active",
   "summary_plain": "Helps you START A NEW unit: the bank gives a loan and the government pays 15%-35% of the project cost as a one-time margin-money subsidy.",
   "criteria": [
    {
     "id": "age",
     "label": "Owner is 18 or older",
     "field": "owner_age",
     "op": "gte",
     "value": 18,
     "hard": true,
     "source_ref": "s1"
    },
    {
     "id": "new",
     "label": "It is a NEW project (not an existing unit)",
     "field": "is_new_project",
     "op": "is_true",
     "value": null,
     "hard": true,
     "source_ref": "s1",
     "note": "Assistance is only for new projects sanctioned under PMEGP."
    },
    {
     "id": "activity",
     "label": "Manufacturing or service activity",
     "field": "business_activity",
     "op": "in",
     "value": [
      "manufacturing",
      "service"
     ],
     "hard": true,
     "unknown_values": [
      "trading"
     ],
     "source_ref": "s1",
     "note": "Business/trading projects are allowed only in limited cases (cap at par with service). Check the negative list."
    },
    {
     "id": "cap_mfg",
     "label": "Project cost within ₹50 lakh (manufacturing)",
     "field": "project_cost_inr",
     "op": "lte",
     "value": 5000000,
     "hard": true,
     "when": {
      "field": "business_activity",
      "op": "eq",
      "value": "manufacturing"
     },
     "source_ref": "s1"
    },
    {
     "id": "cap_svc",
     "label": "Project cost within ₹20 lakh (service/business)",
     "field": "project_cost_inr",
     "op": "lte",
     "value": 2000000,
     "hard": true,
     "when": {
      "field": "business_activity",
      "op": "in",
      "value": [
       "service",
       "trading"
      ]
     },
     "source_ref": "s1"
    },
    {
     "id": "edu_mfg",
     "label": "Class 8 pass (needed above ₹10 lakh, manufacturing)",
     "field": "education_8th_pass",
     "op": "is_true",
     "value": null,
     "hard": true,
     "when": {
      "all": [
       {
        "field": "business_activity",
        "op": "eq",
        "value": "manufacturing"
       },
       {
        "field": "project_cost_inr",
        "op": "gt",
        "value": 1000000
       }
      ]
     },
     "source_ref": "s1"
    },
    {
     "id": "edu_svc",
     "label": "Class 8 pass (needed above ₹5 lakh, service/business)",
     "field": "education_8th_pass",
     "op": "is_true",
     "value": null,
     "hard": true,
     "when": {
      "all": [
       {
        "field": "business_activity",
        "op": "in",
        "value": [
         "service",
         "trading"
        ]
       },
       {
        "field": "project_cost_inr",
        "op": "gt",
        "value": 500000
       }
      ]
     },
     "source_ref": "s1"
    },
    {
     "id": "no_prior",
     "label": "Has not already received a government subsidy for this unit",
     "field": "prior_govt_subsidy",
     "op": "is_false",
     "value": null,
     "hard": true,
     "source_ref": "s1"
    }
   ],
   "benefits": [
    {
     "type": "grant",
     "label": "Margin-money subsidy on project cost",
     "estimator": "pmegp_subsidy"
    },
    {
     "type": "credit",
     "label": "Bank term loan for the rest of the project cost (own contribution 5-10%)"
    }
   ],
   "rates": {
    "general": {
     "urban": 0.15,
     "rural": 0.25
    },
    "special": {
     "urban": 0.25,
     "rural": 0.35
    },
    "own_contribution": {
     "general": 0.1,
     "special": 0.05
    },
    "special_category_definition": "SC/ST/OBC/Minorities/Women/Ex-servicemen/Differently-abled/Transgender/NER/Hill & Border/Aspirational districts"
   },
   "documents": [
    "Aadhaar",
    "PAN",
    "Project report",
    "Education certificate (if project above the class-8 threshold)",
    "Special-category certificate (if claimed)",
    "Rural-area certificate (if rural)",
    "Bank details"
   ],
   "application": {
    "channel": "PMEGP e-portal (KVIC)",
    "url": "https://www.kviconline.gov.in/pmegpeportal/",
    "steps": [
     "Fill the online application",
     "Upload project report and documents",
     "District task force / agency review",
     "Bank sanctions loan",
     "EDP training, then subsidy released to the loan account"
    ]
   },
   "sources": [
    {
     "id": "s1",
     "title": "PMEGP scheme page, District Magistrate (Central), Govt of NCT of Delhi",
     "url": "https://dccentral.delhi.gov.in/en/dccentral/pmegp-scheme",
     "publisher": "Govt of NCT of Delhi"
    },
    {
     "id": "s2",
     "title": "Revised PMEGP guidelines (DKVIB)",
