    {
     "id": "not_yet",
     "label": "You are not yet Udyam-registered",
     "field": "udyam_registered",
     "op": "is_false",
     "value": null,
     "hard": true,
     "source_ref": "s1"
    },
    {
     "id": "pan",
     "label": "You have a PAN",
     "field": "pan_available",
     "op": "is_true",
     "value": null,
     "hard": true,
     "fix": {
      "action_id": "get_pan",
      "label": "Apply for a PAN card (needed for Udyam registration)"
     },
     "source_ref": "s1"
