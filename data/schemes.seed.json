   "state": null,
   "ministry": "Ministry of MSME",
   "kind": "registration",
   "status": "active",
   "summary_plain": "Free government registration that officially recognises your business as a Micro, Small or Medium Enterprise. Many schemes and bank programmes ask for it.",
